{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "page",
    "recap",
    "stations",
    "creditsIntro"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contentVersion": {
      "type": "string"
    },
    "page": {
      "type": "object"
    },
    "recap": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    },
    "stations": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "type",
          "title",
          "classification",
          "child",
          "deeper",
          "media",
          "interaction"
        ]
      }
    },
    "creditsIntro": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}

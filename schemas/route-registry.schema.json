{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "enabled",
          "path",
          "match",
          "mountId",
          "pageSystem",
          "releaseChannel",
          "fallbackRequired",
          "environment",
          "allowedHosts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "pattern": "^/.+/$"
          },
          "match": {
            "const": "exact"
          },
          "mountId": {
            "type": "string"
          },
          "pageSystem": {
            "type": "string"
          },
          "releaseChannel": {
            "type": "string"
          },
          "fallbackRequired": {
            "const": true
          },
          "environment": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowedHosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
